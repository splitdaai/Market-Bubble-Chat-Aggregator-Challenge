# ──────────────────────────────────────────────────────────────────────────
#  Market Bubble — backend environment
#  Copy to `backend/.env` and fill in the platforms you want to connect.
#  Any platform left blank is skipped; the app degrades gracefully.
#
#  Tiers of capability per platform:
#    • CHAT (messages in the feed)      • VIEWERS (live counts in stats)
#    • MODERATION (timeout/ban/etc.)    • CLIPS (native clip cutting)
# ──────────────────────────────────────────────────────────────────────────

PORT=4000
# Frontend origin allowed to connect (set to your deployed URL in prod).
CORS_ORIGIN=http://localhost:5184

# Where completed stream sessions are persisted for the analytics tab.
HISTORY_FILE=data/history.json

# ── Twitch ────────────────────────────────────────────────────────────────
# CHAT: channel name (no #) — reads anonymously.
TWITCH_CHANNEL=your_channel
# MODERATION: a mod/broadcaster account + OAuth token with chat:edit +
# channel:moderate scopes. Generate at https://twitchtokengenerator.com
TWITCH_USERNAME=your_bot_or_mod_username
TWITCH_OAUTH=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VIEWERS + CLIPS: register an app at https://dev.twitch.tv/console → get a
# Client ID + Secret (used for the Helix viewer count + clip creation).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# CLIPS only: a USER token with clips:edit + your numeric broadcaster id.
TWITCH_USER_TOKEN=
TWITCH_BROADCASTER_ID=

# ── Kick ──────────────────────────────────────────────────────────────────
# CHAT + VIEWERS: channel slug from the URL kick.com/<slug> (public, no auth).
KICK_CHANNEL=your_kick_slug
# MODERATION: a logged-in session bearer token (optional).
KICK_BEARER=

# ── X / Twitter ───────────────────────────────────────────────────────────
# CHAT: OAuth 2.0 App-Only Bearer token (developer.twitter.com) for the
# filtered stream. (X has no public live-viewer count.)
X_BEARER_TOKEN=
X_STREAM_RULES=#yourstream,@yourhandle

# ── YouTube (viewers) ─────────────────────────────────────────────────────
# VIEWERS: Data API v3 key + the live video id. Used only when X isn't running.
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=

# ──────────────────────────────────────────────────────────────────────────
#  Frontend (frontend/.env)
#  Leave VITE_BACKEND_URL UNSET for self-contained DEMO mode (mock firehose).
#  Set it to this backend to go LIVE — all data then comes from here.
# ──────────────────────────────────────────────────────────────────────────
# VITE_BACKEND_URL=http://localhost:4000
