# The previous EC2/ALB backend at https://3-213-104-77.nip.io is no longer a
# valid Socket.io target. Leave the general backend empty so production does
# not spam failed TLS socket attempts; live data surfaces use direct fallbacks.
VITE_BACKEND_URL=

