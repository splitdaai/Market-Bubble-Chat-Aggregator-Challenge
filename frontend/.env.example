# Frontend env. Copy to `frontend/.env`.
#
# Leave VITE_BACKEND_URL UNSET to run in self-contained DEMO mode (mock
# firehose, warm-started mid-broadcast, seeded analytics history).
#
# Set it to your running backend to go LIVE — the app then takes ALL data from
# the backend (real chat messages, viewer counts via `stats`, past streams via
# `history`) and every mock is bypassed automatically.
# VITE_BACKEND_URL=http://localhost:4000
